{
  "name": "@nickmous/astro-i18n",
  "version": "0.1.0",
  "type": "module",
  "description": "Type-safe, namespaced i18n for Astro and any TypeScript project. Dotted keys, no codegen.",
  "license": "MIT",
  "author": "NickMous",
  "keywords": [
    "i18n",
    "astro",
    "typescript",
    "type-safe",
    "internationalization"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "test:unit": "vitest run",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
